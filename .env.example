# Copy this file to .env and fill in a fresh API key.
# Do not commit .env.

PAPER_LAB_PROVIDER=openai
OPENAI_API_KEY=replace_me_with_a_new_openai_api_key
PAPER_LAB_MODEL=gpt-4.1
PAPER_LAB_BASE_URL=https://api.openai.com/v1

# false keeps Responses API calls stateless and avoids storing response objects.
PAPER_LAB_STORE=false

# Retries 429 rate-limit responses with automatic waiting.
PAPER_LAB_MAX_RETRIES=5
